# Public URL clients use to reach the Streamable HTTP server. HTTPS is
# mandatory outside localhost and should terminate at a reverse proxy or load
# balancer in front of the container.
MCP_HTTP_BASE_URL=http://localhost:8000

# OIDC bearer-token verifier used to authenticate MCP clients.
MCP_HTTP_JWT_ISSUER=https://issuer.example.com
MCP_HTTP_JWT_AUDIENCE=google-workspace-mcp
MCP_HTTP_JWKS_URI=https://issuer.example.com/.well-known/jwks.json

# Must be registered in the Google Cloud OAuth client and served below
# MCP_HTTP_BASE_URL.
MCP_GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8000/google/oauth/callback

# Development-only single Fernet key. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production deployments should mount a versioned MCP_SECRET_FILE instead.
MCP_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Optional integrations and infrastructure.
# ENABLE_GEMINI=false
# GEMINI_API_KEY=
# MCP_REDIS_URL=redis://redis:6379/0
# MCP_UPLOAD_S3_BUCKET=

# MCP Apps application state. Dashboard views are addressed by server-issued
# handles bound to the authenticated principal; their state lives in
# MCP_REDIS_URL for the HTTP fleet (encrypted with the token key ring) and in
# process memory for stdio. A view expires after this many seconds without use
# (sliding; default 86400 = 24h, allowed 60..2592000).
# MCP_APP_VIEW_TTL_SECONDS=86400
#
# Workspace Files picker uploads (local and remote): lifetime from upload
# (default 3600, allowed 60..604800) and per-principal aggregate quota
# (default 262144000 = 250 MiB).
# MCP_UPLOAD_TTL_SECONDS=3600
# MCP_UPLOAD_QUOTA_BYTES=262144000
#
# Background tasks (MCP Tasks extension, io.modelcontextprotocol/tasks).
# The HTTP server and any out-of-process worker use MCP_REDIS_URL as the task
# queue unless FASTMCP_DOCKET_URL is set explicitly; without either, tasks use
# an in-process memory:// queue. The local stdio bundle never joins a shared
# queue implicitly. The queue name defaults to "mcp-google-workspace".
# FASTMCP_DOCKET_URL=redis://redis:6379/1
# FASTMCP_DOCKET_NAME=mcp-google-workspace
# FASTMCP_DOCKET_CONCURRENCY=10
#
# Encrypts the caller-credential snapshot each queued task stores in Redis
# (not tool arguments or results). Every server and worker sharing a queue must
# use the same value; drain the queue before rotating it. Use at least 32
# random characters from your secret manager; never commit a real value.
# FASTMCP_TASKS_ENCRYPTION_KEY=

# Multi-round-trip confirmation continuations (MCP 2026-07-28).
# Destructive/consequential tools first return an "input required" question and
# resume when the client retries with the answer, possibly on another replica.
# The continuation (requestState) is sealed with this key ring, which every
# replica must share. Comma-separated secrets, each at least 32 bytes; the
# FIRST entry seals new continuations and every listed entry verifies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Without it each process uses an ephemeral key: fine for stdio, but HTTP logs
# a warning and /health/ready fails when MCP_WORKERS > 1.
#
# Rotation (independent of MCP_TOKEN_ENCRYPTION_KEY / MCP_SECRET_FILE and of
# FASTMCP_TASKS_ENCRYPTION_KEY; no queue drain or token re-encryption needed):
#   1. MCP_REQUEST_STATE_KEYS=<new>,<old>   roll out to every replica
#   2. wait at least MCP_CONFIRMATION_TTL_SECONDS (open confirmations expire)
#   3. MCP_REQUEST_STATE_KEYS=<new>         roll out to every replica
# A confirmation sealed only with a removed key fails with "Invalid or expired
# requestState"; nothing is executed and the user confirms again.
# MCP_REQUEST_STATE_KEYS=
#
# Lifetime of an unanswered confirmation, in seconds (30..86400, default 600).
# prepare_workspace_action commit tokens use the same lifetime.
# MCP_CONFIRMATION_TTL_SECONDS=600

# Durable operation records (prepare/commit and confirmations; W4b).
# Stored in memory for stdio and single-process servers; in Redis (encrypted
# with the token key ring above) when MCP_REDIS_URL is set, except in the
# stdio bundle. A repeated commit or confirmed request returns the saved
# result instead of executing again; an uncertain outcome is reported as
# outcome_unknown and never retried automatically.
# How long finished records (succeeded / failed / outcome_unknown) are kept
# for replay and reconciliation, in seconds (300..2592000, default 86400).
# MCP_OPERATION_RETENTION_SECONDS=86400
# Execution lease: a record still "executing" after this many seconds (crashed
# or lost worker) becomes outcome_unknown on the next retry. Keep it above
# MCP_TOOL_DEADLINE_SECONDS and MCP_EXPENSIVE_DEADLINE_SECONDS (30..86400,
# default 900).
# MCP_OPERATION_LEASE_SECONDS=900
# Largest saved result kept for replay, in bytes after message text is
# removed (1024..1048576, default 65536). Larger results are not retained;
# a repeat then reports operation_already_succeeded without re-executing.
# MCP_OPERATION_RESULT_MAX_BYTES=65536
