{
  "initialize": {
    "headers": {
      "content-type": "application/json",
      "mcp-session-id": "<SESSION_ID>"
    },
    "result": {
      "capabilities": {
        "logging": {},
        "prompts": {
          "listChanged": true
        },
        "resources": {
          "listChanged": true,
          "subscribe": false
        },
        "tools": {
          "listChanged": true
        }
      },
      "instructions": "Unified Google Workspace MCP server with Gmail, Calendar, Drive, Docs, Sheets, Tasks, People, Forms, Slides, and optional Meet/Keep/Chat/Gemini integrations.",
      "protocolVersion": "2025-11-25",
      "serverInfo": {
        "description": "Lets an agent work in a user's Google Workspace: search and send Gmail, read and schedule Calendar events, find and manage Drive files, read and edit Docs, Sheets, Slides and Forms, manage Tasks and Contacts, with consent prompts before consequential actions.",
        "icons": [
          {
            "mimeType": "image/png",
            "sizes": [
              "1024x1024"
            ],
            "src": "https://raw.githubusercontent.com/guinacio/mcp-google-workspace/main/icon.png"
          }
        ],
        "name": "google-workspace-mcp",
        "title": "Google Workspace",
        "version": "<SERVER_VERSION>",
        "websiteUrl": "https://github.com/guinacio/mcp-google-workspace"
      }
    },
    "status_code": 200
  },
  "safe_call": {
    "result": {
      "content": [
        {
          "text": "{\"resource\":{\"kind\":\"calendar_event\",\"id\":\"evt-1\",\"uri\":\"gcal-event:///evt-1\"},\"verified\":false}",
          "type": "text"
        }
      ],
      "isError": false,
      "structuredContent": {
        "resource": {
          "id": "evt-1",
          "kind": "calendar_event",
          "uri": "gcal-event:///evt-1"
        },
        "verified": false
      }
    },
    "status_code": 200
  },
  "tools_list": {
    "actual_tool_count_over_100": false,
    "named_tools": {
      "get_google_connection_status": {
        "_meta": {
          "fastmcp": {
            "tags": [
              "connection",
              "get",
              "get-google-connection-status",
              "google",
              "google-workspace",
              "status"
            ]
          }
        },
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Check whether the calling user has a stored Google connection and which services it grants, and what this server offers, without calling Google. Use it before connect_google_workspace, after a consent finishes, or to learn the active tool tier; for remote users tools/list already reflects the current grants, so list tools again after consent. Returns state (connected, refresh_required, missing_scopes, reauth_required, not_connected or error), connected, granted_capabilities, granted_scopes, expires_at, an action hint when the user must reconnect, and server (tool_tier, enabled_namespaces, optional_namespaces, oauth_capabilities, file_inputs, tool_search).",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "capability": {
              "description": "One service to verify, e.g. 'calendar'; if the grant lacks its scopes, state is missing_scopes. Omit to report the overall connection only.",
              "enum": [
                "calendar",
                "chat",
                "docs",
                "drive",
                "forms",
                "gmail",
                "keep",
                "meet",
                "people",
                "sheets",
                "slides",
                "tasks"
              ],
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "name": "get_google_connection_status",
        "outputSchema": {
          "additionalProperties": true,
          "properties": {
            "action": {
              "description": "What the user must do to reconnect, or null.",
              "type": [
                "string",
                "null"
              ]
            },
            "checked_capability": {
              "description": "The capability argument, or null.",
              "type": [
                "string",
                "null"
              ]
            },
            "connected": {
              "description": "Whether a usable grant is stored for the caller.",
              "type": "boolean"
            },
            "expires_at": {
              "description": "Access-token expiry, or null.",
              "type": [
                "string",
                "null"
              ]
            },
            "granted_capabilities": {
              "description": "Services the grant covers.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "granted_scopes": {
              "description": "OAuth scopes the grant covers.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "required_scopes": {
              "description": "Scopes checked_capability needs.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "server": {
              "additionalProperties": true,
              "description": "This deployment's tool tier, enabled namespaces, OAuth capabilities and file inputs.",
              "properties": {
                "enabled_namespaces": {
                  "items": {},
                  "type": "array"
                },
                "file_inputs": {
                  "additionalProperties": true,
                  "properties": {
                    "drive": {
                      "type": "string"
                    },
                    "local": {
                      "type": "string"
                    },
                    "remote": {
                      "type": "string"
                    }
                  },
                  "required": [],
                  "type": "object"
                },
                "oauth_capabilities": {
                  "items": {},
                  "type": "array"
                },
                "optional_namespaces": {
                  "additionalProperties": true,
                  "properties": {
                    "apps": {
                      "type": "boolean"
                    },
                    "chat": {
                      "type": "boolean"
                    },
                    "gemini": {
                      "type": "boolean"
                    },
                    "keep": {
                      "type": "boolean"
                    },
                    "meet": {
                      "type": "boolean"
                    }
                  },
                  "required": [],
                  "type": "object"
                },
                "tool_search": {
                  "type": "boolean"
                },
                "tool_tier": {
                  "type": "string"
                },
                "tool_tiers": {
                  "items": {},
                  "type": "array"
                }
              },
              "required": [],
              "type": "object"
            },
            "state": {
              "description": "Connection state: connected, refresh_required, missing_scopes, reauth_required, not_connected or error.",
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "title": "Get Google Connection Status"
      }
    },
    "status_code": 200
  }
}
